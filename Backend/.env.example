# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/smart_portfolio_builder

# Port the Express server listens on.
PORT=4000

# Origin(s) allowed to call this API with credentials (cookies).
# Comma-separate multiple origins if needed, e.g.:
# CORS_ORIGIN=https://app.your-domain.com,https://staging.your-domain.com
# Local dev default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# development | production
# In production this also switches the session cookie to Secure + SameSite=None,
# which is required when the frontend and backend are on different origins.
NODE_ENV=development

# Secret used to sign/verify session JWTs.
# Use a long, random value in production (e.g. `openssl rand -base64 48`) and never reuse
# the dev value.
JWT_SECRET=replace-with-a-long-random-secret
