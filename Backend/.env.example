# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/smart_portfolio_builder

# Port the Express server listens on.
PORT=4000

# Origin(s) allowed to call this API with credentials (cookies).
# Comma-separate multiple origins if needed, e.g.:
# CORS_ORIGIN=https://app.your-domain.com,https://staging.your-domain.com
# Local dev default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# development | production
# In production this also switches the session cookie to Secure + SameSite=None,
# which is required when the frontend and backend are on different origins.
NODE_ENV=development

# Secret used to sign/verify session JWTs.
# Use a long, random value in production (e.g. `openssl rand -base64 48`) and never reuse
# the dev value.
JWT_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# URLs used by the auth flows
# ---------------------------------------------------------------------------
# Where the frontend SPA is served. OAuth callbacks and password-reset emails link here.
# Defaults to the first CORS_ORIGIN when unset.
FRONTEND_URL=http://localhost:5173
# Public base URL of THIS API. OAuth redirect (callback) URLs are built from it:
#   ${API_PUBLIC_URL}/auth/oauth/google/callback
#   ${API_PUBLIC_URL}/auth/oauth/github/callback
# Register those exact URLs with each provider.
API_PUBLIC_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Social sign-in (optional — a provider stays disabled until both values are set)
# ---------------------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub > Settings > Developer settings > OAuth Apps.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email delivery (password reset)
# ---------------------------------------------------------------------------
# Any SMTP provider (or a local catcher such as Mailpit on port 1025 with no auth).
# Required: SMTP_HOST and SMTP_FROM. SMTP_USER and SMTP_PASSWORD are set together or both left empty.
# The API logs at startup whether it uses SMTP ("Mail delivery: SMTP configured") and checks the
# connection. With no SMTP_* values in development, emails (including reset links) are printed
# to the API console instead. In production an SMTP server is required.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); defaults to true only when SMTP_PORT=465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Smart Portfolio Builder <no-reply@your-domain.com>"
